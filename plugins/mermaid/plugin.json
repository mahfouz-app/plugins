{
  "schema": 1,
  "id": "mermaid",
  "version": "1.3.0",
  "label": "Mermaid diagrams",
  "description": "Render mermaid code blocks as diagrams, and edit one in a split editor tab",
  "mahfouz": ">=0.8.0",
  "apiVersion": 1,
  "icon": "icon.svg",
  "logo": "logo.svg",
  "install": [
    {
      "type": "download",
      "extract": "tar.gz",
      "to": "vendor",
      "include": [
        "package/LICENSE",
        "package/dist/mermaid.esm.min.mjs",
        "package/dist/chunks/mermaid.esm.min"
      ],
      "artifacts": {
        "any": {
          "url": "https://registry.npmjs.org/mermaid/-/mermaid-12.0.0.tgz",
          "sha256": "7df1e7de572d26ea7aca5eaa7b0e77f5caacb63567006f4077c2753d730ffd9d"
        }
      }
    }
  ],
  "frontend": "index.js"
}
