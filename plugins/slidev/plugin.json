{
  "schema": 1,
  "id": "slidev",
  "version": "1.5.0",
  "label": "Slidev presentations",
  "description": "Present notes as slides",
  "mahfouz": ">=0.9.0",
  "apiVersion": 1,
  "install": [
    {
      "type": "download",
      "extract": "tar.gz",
      "to": "runtime",
      "artifacts": {
        "darwin-arm64": {
          "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-darwin-arm64.tar.gz",
          "sha256": "bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057"
        },
        "darwin-x64": {
          "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-darwin-x64.tar.gz",
          "sha256": "1462cb3b3046b815cf8ea436d3da450ec1a9f11dac7e5a46b0ada5305d7e8097"
        }
      }
    },
    { "type": "npm", "dir": ".", "progress": "npm-fetch" }
  ],
  "node": {
    "darwin-arm64": "runtime/node-v24.21.0-darwin-arm64/bin/node",
    "darwin-x64": "runtime/node-v24.21.0-darwin-x64/bin/node"
  },
  "frontend": "index.js",
  "sidecar": { "runtime": "node", "entry": "sidecar.js" }
}
